Функция Группакулеров() Экспорт
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Комплектующее.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Комплектующее КАК Комплектующее
		|ГДЕ
		|	Комплектующее.ЭтоГруппа
		|	И Комплектующее.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", "Охлаждение");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
		Возврат Справочники.Комплектующее.НайтиПоКоду("000000019");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции      

Функция ПроверитьПару(К1, К2)
	
	Если НЕ ЗначениеЗаполнено(К1) Или НЕ ЗначениеЗаполнено(К2) Тогда
		Возврат "";
	КонецЕсли;
	
	Тип1 = К1.ТипКомплектующего;
	Тип2 = К2.ТипКомплектующего;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Правила.Ссылка КАК Правило,
	|   Правила.Тип1 КАК ТипПравила1,
	|   Правила.Тип2 КАК ТипПравила2,
	|   ПравилаТЧ.Свойство1,
	|   ПравилаТЧ.Свойство2,                  
	|   ПравилаТЧ.ТипСравнения
	|ИЗ
	|   Справочник.ПравилаСовместимости КАК Правила
	|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПравилаСовместимости.ТабличнаяЧасть КАК ПравилаТЧ
	|       ПО ПравилаТЧ.Ссылка = Правила.Ссылка
	|ГДЕ
	|   (Правила.Тип1 = &Тип1 И Правила.Тип2 = &Тип2)
	|   ИЛИ
	|   (Правила.Тип1 = &Тип2 И Правила.Тип2 = &Тип1)";
	
	Запрос.УстановитьПараметр("Тип1", Тип1);
	Запрос.УстановитьПараметр("Тип2", Тип2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ТипПравила1 = Тип1 Тогда
			Объект1 = К1;
			Объект2 = К2;
		Иначе
			Объект1 = К2;
			Объект2 = К1;
		КонецЕсли;
		
		Знач1 = ПолучитьЗначение(Объект1, Выборка.Свойство1);
		Знач2 = ПолучитьЗначение(Объект2, Выборка.Свойство2);
		
		Если НЕ Сравнить(Знач1, Знач2, Выборка.ТипСравнения) Тогда
			Возврат "Несовместимость: " 
			+ Строка(Объект1) + " и " + Строка(Объект2)
			+ " по свойству " + Строка(Выборка.Свойство1);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьЗначение(Объект, Свойство)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   ЗначениеСправочник,
    |   ЗначениеЧисло,
    |   ЗначениеСтрока
    |ИЗ
    |   РегистрСведений.ЗначенияСвойствКомплектующих
    |ГДЕ
    |   Объект = &Объект
    |   И Свойство = &Свойство";

    Запрос.УстановитьПараметр("Объект", Объект);
    Запрос.УстановитьПараметр("Свойство", Свойство);

    Результат = Запрос.Выполнить().Выбрать();

    Если Результат.Следующий() Тогда
        Если ЗначениеЗаполнено(Результат.ЗначениеСправочник) Тогда
            Возврат Результат.ЗначениеСправочник;
        ИначеЕсли ЗначениеЗаполнено(Результат.ЗначениеЧисло) Тогда
            Возврат Результат.ЗначениеЧисло;
        Иначе
            Возврат Результат.ЗначениеСтрока;
        КонецЕсли;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

Функция Сравнить(З1, З2, ТипСравнения)
	
	Если З1 = Неопределено Или З2 = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипСравнения = Перечисления.ТипСравнения.Равно Тогда
		Возврат З1 = З2;
		
	ИначеЕсли ТипСравнения = Перечисления.ТипСравнения.Больше Тогда
		Возврат З1 >= З2;
		
	ИначеЕсли ТипСравнения = Перечисления.ТипСравнения.Меньше Тогда
		Возврат З1 <= З2;
		
	Иначе
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции 

Функция ПроверитьСовместимостьСервер(МассивКомплектующих) Экспорт

    Для i = 0 По МассивКомплектующих.Количество() - 1 Цикл
        Для j = i + 1 По МассивКомплектующих.Количество() - 1 Цикл

            Ошибка = ПроверитьПару(
                МассивКомплектующих[i],
                МассивКомплектующих[j]
            );

            Если Ошибка <> "" Тогда
                Возврат Ошибка;
            КонецЕсли;

        КонецЦикла;
    КонецЦикла;

    Возврат "";

КонецФункции

Функция ПолучитьПоследнююЦенуЗакупки(Комплектующее, ДатаЦены = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Комплектующее) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ДатаЦены = Неопределено Тогда
		ДатаЦены = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныКомплектующих КАК Цены
	|ГДЕ
	|	Цены.Комплектующее = &Комплектующее
	|	И Цены.Период <= &ДатаЦены
	|
	|УПОРЯДОЧИТЬ ПО
	|	Цены.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Комплектующее", Комплектующее);
	Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ЗаписатьЦенуКомплектующего(Комплектующее, Цена, ДатаЦены = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Комплектующее) Или Цена <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаЦены = Неопределено Тогда
		ДатаЦены = ТекущаяДата();
	КонецЕсли;
	
	Если ПолучитьПоследнююЦенуЗакупки(Комплектующее, ДатаЦены) = Цена Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЦены = РегистрыСведений.ЦеныКомплектующих.СоздатьМенеджерЗаписи();
	ЗаписьЦены.Период = ДатаЦены;
	ЗаписьЦены.Комплектующее = Комплектующее;
	ЗаписьЦены.Цена = Цена;
	ЗаписьЦены.Записать();
	
КонецПроцедуры

Функция РассчитатьСебестоимостьКомплектующих(Комплектующие, ДатаЦены = Неопределено) Экспорт
	
	Сумма = 0;
	
	Для Каждого СтрокаКомплектующих Из Комплектующие Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКомплектующих.Комплектующее) Тогда
			Продолжить;
		КонецЕсли;
		
		Сумма = Сумма + ПолучитьПоследнююЦенуЗакупки(СтрокаКомплектующих.Комплектующее, ДатаЦены) * СтрокаКомплектующих.Количество;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

Функция ПолучитьКомплектующиеСборки(ДокументСборки) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Комплектующее", Новый ОписаниеТипов("СправочникСсылка.Комплектующее"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.Процессор, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.МатеринскаяПлата, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.БлокПитания, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.Корпус, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.Видеокарта, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.ОхлаждениеПроцессора, 1);
	ДобавитьКомплектующееВТаблицу(ТЗ, ДокументСборки.ОперативнаяПамять, 1);
	
	Для Каждого ТекСтрокаНакопители Из ДокументСборки.Накопители Цикл
		ДобавитьКомплектующееВТаблицу(ТЗ, ТекСтрокаНакопители.Накопитель, ТекСтрокаНакопители.Количество);
	КонецЦикла;
	
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаТЗ.Количество = СтрокаТЗ.Количество * ДокументСборки.Количество;
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Процедура ДобавитьКомплектующееВТаблицу(ТЗ, Комплектующее, Количество)
	
	Если НЕ ЗначениеЗаполнено(Комплектующее) Или Количество <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Комплектующее = Комплектующее;
	НоваяСтрока.Количество = Количество;
	
КонецПроцедуры

Функция ПолучитьЦенуГарантии(Гарантия) Экспорт
	
	Если ЗначениеЗаполнено(Гарантия) Тогда
		Возврат Гарантия.Цена;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

