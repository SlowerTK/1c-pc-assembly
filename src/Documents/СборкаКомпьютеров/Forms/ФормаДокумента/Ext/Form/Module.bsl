Функция ПроверкаСовместимости()
	
	Массив = Новый Массив;
	Если ЗначениеЗаполнено(Объект.Процессор) Тогда
		Массив.Добавить(Объект.Процессор);	
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.МатеринскаяПлата) Тогда
		Массив.Добавить(Объект.МатеринскаяПлата);	
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ОперативнаяПамять) Тогда
		Массив.Добавить(Объект.ОперативнаяПамять);	
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Видеокарта) Тогда
		Массив.Добавить(Объект.Видеокарта);		
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.БлокПитания) Тогда
		Массив.Добавить(Объект.БлокПитания);	
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Корпус) Тогда
		Массив.Добавить(Объект.Корпус);	
	КонецЕсли;
	
	Ошибка = Сервисный.ПроверитьСовместимостьСервер(Массив);
	
	Если Ошибка <> "" Тогда
		Сообщить(Ошибка);
	КонецЕсли;
	
КонецФункции // ПроверкаСовместимости()

