
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.Накопители.Количество() <= 1 Тогда
		Элементы.ГруппаОдиночнойСтроки.Видимость = Истина;
		Элементы.Накопители.Видимость = Ложь;
	Иначе
		Элементы.ГруппаОдиночнойСтроки.Видимость = Ложь;
		Элементы.Накопители.Видимость = Истина;
	КонецЕсли;
	Если Объект.Накопители.Количество() = 0 Тогда
		НоваяСтрока = Объект.Накопители.Добавить();
		НоваяСтрока.Количество = 1;
	КонецЕсли;
	
	ПересчитатьЦены();
	
	//ЗадатьОграничение();
КонецПроцедуры

