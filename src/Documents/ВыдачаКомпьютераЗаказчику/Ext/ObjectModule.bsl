Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СборкаКомпьютеров") Тогда
		// Заполнение шапки
		Заказчик = ДанныеЗаполнения.Заказчик;
		ДокументСборки = ДанныеЗаполнения;
		ЦенаПродажи = РассчитатьЦенуПродажи(ДокументСборки, ДополнительнаяГарантия);
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если НЕ ЗначениеЗаполнено(ДокументСборки) Тогда
		Сообщить("Не выбран документ сборки");
		Отказ = Истина;
	ИначеЕсли ДокументСборки.Заказчик <> Заказчик Тогда
		Сообщить("Не верно выбран документ или заказчик, попробуйте создать документ выдачи на основании документа сборки");
		Отказ = Истина;
	ИначеЕсли НЕ ДокументСборки.Проведен Тогда
		Сообщить("Документ сборки компьютера ещё не проведён. Сначала нужно провести документ сборки");
		Отказ = Истина;
	Иначе
		Если ЦенаПродажи = 0 Тогда
			ЦенаПродажи = РассчитатьЦенуПродажи(ДокументСборки, ДополнительнаяГарантия);
		КонецЕсли;

		ЗаписатьСостояниеСборки(Перечисления.СтатусСборки.Выдан, Сервисный.ПолучитьЦенуГарантии(ДополнительнаяГарантия));
	КонецЕсли;
	
	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ЗначениеЗаполнено(ДокументСборки) Тогда
		ЗаписатьСостояниеСборки(Перечисления.СтатусСборки.ВСборке, 0);
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьЦенуПродажи(ДокументСборки, Гарантия)
	
	Если НЕ ЗначениеЗаполнено(ДокументСборки) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ДокументСборки.РекомендуемаяЦена + Сервисный.ПолучитьЦенуГарантии(Гарантия);
	
КонецФункции

Процедура ЗаписатьСостояниеСборки(Статус, СтоимостьГарантии)
	
	Себестоимость = ДокументСборки.СтоимостьКомплектующих;
	Комплектующие = Сервисный.ПолучитьКомплектующиеСборки(ДокументСборки);
	
	НаборЗаписей = РегистрыСведений.СобранныеКомпьютеры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументСборки);
	
	Для Каждого СтрокаКомплектующие Из Комплектующие Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКомплектующие.Комплектующее) Или СтрокаКомплектующие.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = НаборЗаписей.Добавить();
		Движение.ДокументСборки = ДокументСборки;
		Движение.Заказчик = ДокументСборки.Заказчик;
		Движение.АвторСборки = ДокументСборки.Сборщик;
		Движение.Комплектующие = СтрокаКомплектующие.Комплектующее;
		Движение.Количество = СтрокаКомплектующие.Количество;
		Движение.Себестоимость = Себестоимость;
		Движение.СтоимостьРаботы = ДокументСборки.СтоимостьРаботы;
		Движение.СтоимостьГарантии = СтоимостьГарантии;
		Движение.ЦенаПродажи = ?(Статус = Перечисления.СтатусСборки.Выдан, ЦенаПродажи, ДокументСборки.РекомендуемаяЦена);
		Движение.Статус = Статус;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры
